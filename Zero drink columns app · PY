import os

import altair as alt
import pandas as pd
import streamlit as st

st.set_page_config(page_title="제로음료 열별 그래프", page_icon="🥤", layout="wide")

DEFAULT_CSV = "zero_drinks.csv"

NUTRIENTS = {
    "에너지_kcal": ("에너지 (kcal)", "#e8743b"),
    "단백질_g": ("단백질 (g)", "#4c78a8"),
    "지방_g": ("지방 (g)", "#f2b134"),
    "탄수화물_g": ("탄수화물 (g)", "#7a5195"),
    "당류_g": ("당류 (g)", "#d1495b"),
    "나트륨_mg": ("나트륨 (mg)", "#2a9d8f"),
    "포화지방_g": ("포화지방 (g)", "#8d6e63"),
}


@st.cache_data
def load_csv(source):
    try:
        return pd.read_csv(source, encoding="utf-8-sig")
    except UnicodeDecodeError:
        if hasattr(source, "seek"):
            source.seek(0)
        return pd.read_csv(source, encoding="cp949")


def sugar_label(name: str) -> str:
    """식품명에 들어 있는 '제로' 표시 문구를 분류"""
    for key in ["제로칼로리", "저칼로리", "제로슈거", "제로슈가", "노슈거"]:
        if key in name:
            return key
    if "제로" in name:
        return "제로(기타)"
    return "표시 없음"


# ---------- 데이터 ----------
st.title("🥤 제로음료 영양성분 – 열별 그래프")
st.caption("각 열의 성격(범주형 / 숫자형 / 날짜)에 맞는 그래프로 보여줍니다.")

with st.sidebar:
    st.header("설정")
    uploaded = st.file_uploader("CSV 업로드", type="csv")

if uploaded is not None:
    df = load_csv(uploaded)
elif os.path.exists(DEFAULT_CSV):
    df = load_csv(DEFAULT_CSV)
else:
    st.info(f"사이드바에서 CSV를 업로드하거나, 이 파일과 같은 폴더에 `{DEFAULT_CSV}`를 두세요.")
    st.stop()

df = df.copy()
df["데이터생성일"] = pd.to_datetime(df["데이터생성일"], errors="coerce")

with st.sidebar:
    exclude_cake = st.checkbox("케이크 제외 (음료가 아님)", value=True)
    if exclude_cake:
        df = df[df["음료종류"] != "케이크"]
    bins = st.slider("히스토그램 구간 수", 5, 30, 12)
    st.caption(f"분석 대상: {len(df)}개")

# ---------- 요약 ----------
c1, c2, c3 = st.columns(3)
c1.metric("음료 수", len(df))
c2.metric("음료 종류 수", df["음료종류"].nunique())
c3.metric("평균 에너지 (kcal)", f"{df['에너지_kcal'].mean():.1f}")

tab_cat, tab_num, tab_date, tab_rel = st.tabs(
    ["범주형 열", "영양성분 (숫자형 열)", "날짜 열", "성분 간 관계"]
)

# ---------- 범주형 ----------
with tab_cat:
    left, right = st.columns(2)

    with left:
        st.subheader("음료종류")
        cnt = df["음료종류"].value_counts().rename_axis("음료종류").reset_index(name="개수")
        st.altair_chart(
            alt.Chart(cnt)
            .mark_bar()
            .encode(
                x=alt.X("개수:Q", title="음료 수", axis=alt.Axis(tickMinStep=1)),
                y=alt.Y("음료종류:N", sort="-x", title=None),
                color=alt.Color("음료종류:N", legend=None),
                tooltip=["음료종류", "개수"],
            )
            .properties(height=320),
            use_container_width=True,
        )
        st.caption("범주가 여러 개라 막대그래프를 썼어요.")

    with right:
        st.subheader("식품명 속 '제로' 표시 문구")
        lab = (
            df["식품명"].map(sugar_label).value_counts().rename_axis("표시 문구").reset_index(name="개수")
        )
        st.altair_chart(
            alt.Chart(lab)
            .mark_bar()
            .encode(
                x=alt.X("개수:Q", axis=alt.Axis(tickMinStep=1)),
                y=alt.Y("표시 문구:N", sort="-x", title=None),
                color=alt.Color("표시 문구:N", legend=None),
                tooltip=["표시 문구", "개수"],
            )
            .properties(height=320),
            use_container_width=True,
        )
        st.caption("식품명에서 제로칼로리·저칼로리·제로슈거 등을 찾아 센 값이에요.")

    left, right = st.columns(2)
    with left:
        st.subheader("기준단위 / 중량단위")
        unit = df["중량단위"].value_counts().rename_axis("단위").reset_index(name="개수")
        st.altair_chart(
            alt.Chart(unit)
            .mark_arc(innerRadius=60)
            .encode(
                theta="개수:Q",
                color=alt.Color("단위:N", title="단위"),
                tooltip=["단위", "개수"],
            )
            .properties(height=280),
            use_container_width=True,
        )
        st.caption("단위가 ml과 g 두 가지뿐이라 비율을 보는 도넛 차트를 썼어요.")

    with right:
        st.subheader("식품중량")
        st.altair_chart(
            alt.Chart(df)
            .mark_bar()
            .encode(
                x=alt.X("식품중량:Q", bin=alt.Bin(maxbins=bins), title="용량 (ml/g)"),
                y=alt.Y("count():Q", title="음료 수", axis=alt.Axis(tickMinStep=1)),
                tooltip=[alt.Tooltip("count():Q", title="음료 수")],
            )
            .properties(height=280),
            use_container_width=True,
        )
        st.caption("연속형 숫자라 히스토그램을 썼어요.")

# ---------- 숫자형 영양성분 ----------
with tab_num:
    st.caption("값이 비어 있는 음료는 제외하고 그렸어요. 빈 칸 수는 각 그래프 아래에 표시했습니다.")
    keys = list(NUTRIENTS)
    for i in range(0, len(keys), 2):
        cols = st.columns(2)
        for col, key in zip(cols, keys[i : i + 2]):
            title, color = NUTRIENTS[key]
            sub = df.dropna(subset=[key])
            with col:
                st.subheader(title)
                chart = (
                    alt.Chart(sub)
                    .mark_bar(color=color)
                    .encode(
                        x=alt.X(f"{key}:Q", bin=alt.Bin(maxbins=bins), title=title),
                        y=alt.Y("count():Q", title="음료 수", axis=alt.Axis(tickMinStep=1)),
                        tooltip=[alt.Tooltip("count():Q", title="음료 수")],
                    )
                    .properties(height=260)
                )
                st.altair_chart(chart, use_container_width=True)
                miss = int(df[key].isna().sum())
                st.caption(
                    f"값 있음 {len(sub)}개 · 빈 칸 {miss}개 · 평균 {sub[key].mean():.2f} · "
                    f"최댓값 {sub[key].max():.2f}"
                    if len(sub)
                    else f"값이 있는 음료가 없어요 (빈 칸 {miss}개)"
                )

    st.divider()
    st.subheader("음료별 에너지 순위")
    top_n = st.slider("표시할 음료 수", 5, len(df), min(15, len(df)))
    rank = df.sort_values("에너지_kcal", ascending=False).head(top_n)
    st.altair_chart(
        alt.Chart(rank)
        .mark_bar(color=NUTRIENTS["에너지_kcal"][1])
        .encode(
            x=alt.X("에너지_kcal:Q", title="에너지 (kcal)"),
            y=alt.Y("식품명:N", sort="-x", title=None),
            tooltip=["식품명", "음료종류", "에너지_kcal"],
        )
        .properties(height=max(250, 26 * top_n)),
        use_container_width=True,
    )

# ---------- 날짜 ----------
with tab_date:
    st.subheader("데이터생성일")
    d = df.dropna(subset=["데이터생성일"]).copy()
    d["월"] = d["데이터생성일"].dt.to_period("M").dt.to_timestamp()
    monthly = d.groupby("월").size().reset_index(name="개수")
    st.altair_chart(
        alt.Chart(monthly)
        .mark_bar()
        .encode(
            x=alt.X("yearmonth(월):T", title="생성 월"),
            y=alt.Y("개수:Q", title="데이터 수", axis=alt.Axis(tickMinStep=1)),
            tooltip=[alt.Tooltip("yearmonth(월):T", title="월"), "개수"],
        )
        .properties(height=320),
        use_container_width=True,
    )
    st.caption("시간 순서가 있는 열이라 월별 막대(시계열) 그래프를 썼어요.")

# ---------- 성분 간 관계 ----------
with tab_rel:
    st.subheader("영양성분 상관관계")
    num = df[list(NUTRIENTS)].rename(columns={k: v[0] for k, v in NUTRIENTS.items()})
    corr = num.corr().reset_index().melt("index", var_name="성분B", value_name="상관계수")
    corr = corr.rename(columns={"index": "성분A"}).dropna()
    base = alt.Chart(corr).encode(x=alt.X("성분A:N", title=None), y=alt.Y("성분B:N", title=None))
    heat = base.mark_rect().encode(
        color=alt.Color("상관계수:Q", scale=alt.Scale(scheme="redblue", domain=[-1, 1])),
        tooltip=["성분A", "성분B", alt.Tooltip("상관계수:Q", format=".2f")],
    )
    txt = base.mark_text(fontSize=11).encode(text=alt.Text("상관계수:Q", format=".2f"))
    st.altair_chart((heat + txt).properties(height=420), use_container_width=True)
    st.caption("빈 칸이 많은 성분은 값이 있는 음료끼리만 계산되어 신뢰도가 낮을 수 있어요. 표본이 작아서 참고용으로만 보세요.")

    st.subheader("두 성분 직접 비교")
    names = {v[0]: k for k, v in NUTRIENTS.items()}
    a, b = st.columns(2)
    xa = a.selectbox("X축", list(names), index=0)
    yb = b.selectbox("Y축", list(names), index=4)
    sub = df.dropna(subset=[names[xa], names[yb]])
    st.altair_chart(
        alt.Chart(sub)
        .mark_circle(size=90, opacity=0.8)
        .encode(
            x=alt.X(f"{names[xa]}:Q", title=xa),
            y=alt.Y(f"{names[yb]}:Q", title=yb),
            color="음료종류:N",
            tooltip=["식품명", "음료종류", names[xa], names[yb]],
        )
        .properties(height=380)
        .interactive(),
        use_container_width=True,
    )
    st.caption(f"두 값이 모두 있는 음료 {len(sub)}개만 표시됩니다.")
